                  <span className={`px-3 py-1 rounded bg-pink-500/10 text-pink-500 font-mono text-sm font-bold border border-pink-500/20`}>
                    {activeScan.asn}
                  </span>
                </div>
              </div>
            </div>

          </div>
        </div>
      )}
    </div>
  );
}
