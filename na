  const [analysisStep, setAnalysisStep] = useState(0);

  const performAnalysis = async (targetIp, isSelf = false) => {
    setIsAnalyzing(true);
    setShowResults(false);
    setAnalysisStep(1);

    await new Promise(resolve => setTimeout(resolve, 600));
    setAnalysisStep(2);
    
    await new Promise(resolve => setTimeout(resolve, 600));
    setAnalysisStep(3);
    
    await new Promise(resolve => setTimeout(resolve, 600));
    setAnalysisStep(4);
    
    await new Promise(resolve => setTimeout(resolve, 600));

    const generatedScore = isSelf ? 8 : Math.floor(Math.random() * 85) + 10;
    const now = new Date();
    const formattedTime = now.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ' ' + 
      now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });

    let status = 'LOW';
    if (generatedScore >= 70) status = 'HIGH';
    else if (generatedScore >= 85) status = 'CRITICAL';
    else if (generatedScore >= 40) status = 'MEDIUM';

    const newScanEntry = {
      id: Date.now(),
      ip: targetIp,
      country: isSelf ? 'India' : 'United States',
      flag: isSelf ? '🇮🇳' : '🇺🇸',
      region: isSelf ? 'Rajasthan' : 'California',
      city: isSelf ? 'Jaipur' : 'Mountain View',
      timezone: isSelf ? 'Asia/Kolkata (IST)' : 'America/Los_Angeles',
      isp: isSelf ? 'Jio Platforms Limited' : 'Google LLC',
      org: isSelf ? 'Jio Platforms Limited' : 'Google Public DNS',
      asn: isSelf ? 'AS55836' : 'AS15169',
      network: isSelf ? '49.36.80.0/20' : `${targetIp.split('.').slice(0, 3).join('.')}.0/24`,
      type: isSelf ? 'ISP / Broadband' : 'Corporate Network',
      threatScore: generatedScore,
      status: status,
      abuseReports: generatedScore > 50 ? Math.floor(generatedScore / 5) : 0,
      malicious: generatedScore > 60 ? 'Yes' : 'No',
      categories: generatedScore > 60 ? 'Suspicious Traffic, Scanner' : 'None',
      lastReported: generatedScore > 50 ? '3 days ago' : 'Never',
      reputation: generatedScore > 60 ? 'Suspicious' : 'Clean',
      timestamp: formattedTime
    };

    addScan(newScanEntry);
    setIsAnalyzing(false);
    setShowResults(true);
    setAnalysisStep(0);
  };

  const handleAnalyzeMyIp = () => {
    performAnalysis('49.36.82.174', true);
  };

